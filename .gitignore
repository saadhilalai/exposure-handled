# Sony Camera Remote SDK: licensed to each developer, never published here.
# Download it yourself from Sony (see README.md).
CrSDK_*.zip
sdk/

# Sony's LUT files: Sony's, not ours to publish. Only the note saying which file goes here is shared.
luts/*
!luts/README.md

# Website placeholder clips: stand-ins until the real shoot. Remake them with tools/make_placeholder_clips.py
# (it needs the LUT in luts/), so they don't bloat the repo's history.
site/media/placeholder/

# Build output
build/
*.o
*.dylib
*.so
*.dll

# Python
__pycache__/
*.pyc
.venv/

# Camera session data (settings snapshots, change logs, captured frames)
sessions/

# macOS
.DS_Store

# Bridge socket
run/

# Downloaded models (see tools/fetch_models.sh)
models/

# Local backups made by tools/calibrate_grey.py apply (git keeps the history)
config/*.before-*.json
config/face_refs.json

# Local test pages for the website, never shipped
site/_dev/

